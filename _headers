# Cloudflare Pages headers.
#
# The service worker is the one file where a stale copy is an actual bug: the
# browser re-fetches sw.js to decide whether to update, and if a CDN hands it
# back the old bytes the new precache list never installs and the games stay
# pinned to whatever shipped first. Everything else can revalidate normally.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/web/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/manifest+json; charset=utf-8
